{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(tmux split-window:*)",
      "Bash(tmux send-keys:*)",
      "Bash(linearis:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-complete.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/daily-log.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/daily-log.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-complete.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "sandbox": {
{{- if or (eq .chezmoi.hostname "mbvu1314-2") (eq .chezmoi.hostname "Trents-MBP") (eq .chezmoi.hostname "Trents-Mac-mini") }}
    "enabled": false
{{- else }}
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "avatars.githubusercontent.com",
        "api.linear.app",
        "mcp.linear.app",
        "api.graphite.dev",
        "app.graphite.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "{{ .chezmoi.homeDir }}/.config/chezmoi",
        "{{ .chezmoi.homeDir }}/.local/share/chezmoi",
        "{{ .chezmoi.homeDir }}/duet",
        "{{ .chezmoi.homeDir }}/duet-worktrees",
        "{{ .chezmoi.homeDir }}/git/duet",
        "{{ .chezmoi.homeDir }}/git/duet-worktrees",
        "{{ .chezmoi.homeDir }}/code/duet",
        "{{ .chezmoi.homeDir }}/code/duet-worktrees",
        "{{ .chezmoi.homeDir }}/dev/duet",
        "{{ .chezmoi.homeDir }}/dev/duet-worktrees",
        "{{ .chezmoi.homeDir }}/projects/duet",
        "{{ .chezmoi.homeDir }}/projects/duet-worktrees",
        "{{ .chezmoi.homeDir }}/.claude-worktrees"
      ]
    }
{{- end }}
  }
}
