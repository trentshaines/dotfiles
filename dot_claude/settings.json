{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(~/.config/**)",
      "Bash(tmux split-window:*)",
      "Bash(tmux send-keys:*)",
      "Bash(linearis:*)",
      "mcp__Linear__get*",
      "mcp__Linear__list*",
      "mcp__Linear__search*",
      "mcp__postgres-prod-readonly__*",
      "mcp__sentry__*"
    ],
    "deny": [
      "mcp__Linear__create*",
      "mcp__Linear__update*",
      "mcp__Linear__delete*"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-complete.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-autocomplete-optimizer@local-dev": false,
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "model": "claude-opus-4-5@20251101"
}
