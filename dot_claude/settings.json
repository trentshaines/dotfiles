{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(~/.config/**)",
      "Bash(tmux split-window:*)",
      "Bash(tmux send-keys:*)",
      "Bash(linearis:*)",
      "mcp__Linear__*",
      "mcp__postgres-prod-readonly__*",
      "mcp__sentry__*"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-complete.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-autocomplete-optimizer@local-dev": false,
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
