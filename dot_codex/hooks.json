{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pane-title.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-engaged.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-running-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pane-title.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-complete.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-running-end.sh"
          }
        ]
      }
    ]
  }
}
