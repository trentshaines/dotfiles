# git log
glog() {
  git log \
    --graph \
    --topo-order \
    --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' \
    --abbrev-commit \
    "$@"
}

# Commits, pushes, and creates/opens a GitHub PR from the current branch name.
# Specifically for JIRA ticket branch names.
ghprall() {
  # Get the current branch name.
  local branch
  branch=$(git branch --show-current)

  # Check if we are on a branch. If not, show an error and stop.
  if [[ -z "$branch" ]]; then
    echo "❌ Error: Not a git repository or no branch is checked out."
    return 1
  fi

  # Parse the branch to create the commit message.
  local ticket
  ticket=$(echo "$branch" | sed -E "s/^([A-Z]+-[0-9]+).*/\1/")

  local desc
  desc=$(echo "$branch" | sed -E "s/^[A-Z]+-[0-9]+-//" | tr "-" " ")

  local commit_message="$ticket: $desc"

  # Execute the git commands, stopping if any command fails.
  git commit -am "$commit_message" && \
    git push && \
    gh pr create --fill --web
}

