# Tmux
alias ta="tmux attach -t"       # attach to session
alias tn="tmux new -s"          # create new session
alias tls="tmux ls"             # list sessions
alias tk="tmux kill-session -t" # kill session
t() {
  if [ -n "$1" ]; then
    # If you pass a name, try to attach; if it doesn't exist, create it
    tmux attach -t "$1" 2>/dev/null || tmux new -s "$1"
  else
    # No name → just attach to the last used session, or create a default one
    tmux attach 2>/dev/null || tmux new -s default
  fi
}

# Sesh + Tmuxinator - fuzzy session selector
ts() {
  # Get all tmuxinator templates (excluding default.yml)
  local tmuxinator_templates=$(ls ~/.config/tmuxinator/*.yml 2>/dev/null | xargs -n1 basename | sed 's/\.yml$//' | grep -v "^default$")

  # Combine: "home" + tmuxinator templates + sesh list
  local session=$(echo -e "home\n${tmuxinator_templates}\n$(sesh list)" | fzf)

  if [[ -n "$session" ]]; then
    if tmux has-session -t "$session" 2>/dev/null; then
      # Session already exists, connect to it
      sesh connect "$session"
    elif [[ -f ~/.config/tmuxinator/${session}.yml ]]; then
      # It's a tmuxinator template, start it
      tmuxinator start "$session"
    else
      # Use default template for new directories
      tmuxinator start default "$session"
    fi
  fi
}

# Create new git directory and open with tmuxinator
tns() {
  local project_path="$1"
  local template="${2:-default}"

  if [[ -z "$project_path" ]]; then
    echo "Usage: tns <path> [template]"
    echo "  Creates ~/git/<path>, initializes git, and opens with tmuxinator"
    echo "  Examples: tns myproject, tns metr/myproject"
    return 1
  fi

  local project_dir="$HOME/git/$project_path"
  local project_name="$(basename "$project_path")"

  # Check if directory already exists
  if [[ -d "$project_dir" ]]; then
    echo "Directory $project_dir already exists. Opening with tmuxinator..."
  else
    echo "Creating $project_dir..."
    mkdir -p "$project_dir"
    (cd "$project_dir" && git init && echo "# $project_name" > README.md)
    echo "Initialized git repository at $project_dir"
  fi

  # Check if tmux session already exists
  if tmux has-session -t "$project_name" 2>/dev/null; then
    echo "Session $project_name already exists, connecting..."
    sesh connect "$project_name"
  elif [[ -f ~/.config/tmuxinator/${template}.yml ]]; then
    # Use specified template
    echo "Starting tmuxinator with $template template..."
    tmuxinator start "$template" "$project_dir"
  else
    echo "Template $template not found, using default..."
    tmuxinator start default "$project_dir"
  fi
}
