# Search through ripgrep, then filter with fzf after entering.
# Usage: rgf [search terms] [-f pattern] [more terms]
rgf() {
  local file_globs=()
  local terms=()
  local args=("$@")
  local i=1

  # parse args - flags can appear anywhere (zsh arrays are 1-indexed)
  while [[ $i -le ${#args[@]} ]]; do
    case "${args[$i]}" in
      -f|--file)
        ((i++))
        if [[ $i -gt ${#args[@]} ]]; then
          echo "Error: -f requires a file pattern"
          return 1
        fi
        local glob="${args[$i]}"
        # if user didn't include '*' explicitly, wrap with *
        if [[ $glob != *'*'* ]]; then
          glob="*${glob}*"
        fi
        file_globs+=("$glob")
        ;;
      *)
        terms+=("${args[$i]}")
        ;;
    esac
    ((i++))
  done

  local query="${terms[*]:-TODO}"

  # build ripgrep command
  local cmd=(rg --line-number --no-heading --color=always -S "$query")
  for glob in "${file_globs[@]}"; do
    cmd+=(-g "$glob")
  done

  "${cmd[@]}" \
    | fzf --ansi --delimiter : \
          --preview 'bat --style=numbers --color=always --highlight-line {2} {1}' \
          --bind 'enter:execute(nvim +{2} {1} < /dev/tty > /dev/tty 2>&1)'
}

