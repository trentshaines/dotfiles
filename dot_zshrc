# oh my zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
export TERM="xterm-256color"
export LS_COLORS="di=178:ln=180:so=181:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"
plugins=(git z)
source $ZSH/oh-my-zsh.sh

# python
PYTHONPATH="/Me/Documents/mydir:$PYTHONPATH"
export PYTHONPATH

# nvm
export NVM_DIR="$HOME/.nvm"
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
nvm use 20 --silent 

# socks
alias proxyemr="ssh -N -D 18080 tick"

# zoxide
eval "$(zoxide init zsh)"

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# neovim
export EDITOR=nvim
alias v=nvim

# rider
export PATH="/Applications/Rider.app/Contents/MacOS:$PATH"


# autojump script
[ -f $(brew --prefix)/etc/profile.d/autojump.sh ] && . $(brew --prefix)/etc/profile.d/autojump.sh

# Load color support
autoload -U colors && colors

# Vi mode
bindkey -v
export KEYTIMEOUT=1

# Telescope for aerospace
ff() {
    aerospace list-windows --all | fzf --bind 'enter:execute(bash -c "aerospace focus --window-id {1}")+abort'
}

# Git
alias gc="git commit -m"
alias gca="git commit -a -m"
alias gp="git push origin HEAD"
alias gpu="git pull origin"
alias gst="git status"
alias glog="git log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit"
alias gdiff="git diff"
alias gco="git checkout"
alias gb='git branch'
alias gba='git branch -a'
alias gadd='git add'
alias ga='git add -p'
alias gcoall='git checkout -- .'
alias gr='git remote'
alias gre='git reset'

# Rider
alias ri='nohup rider . >/dev/null 2>&1 &'

