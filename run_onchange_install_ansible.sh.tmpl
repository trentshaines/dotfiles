#!/bin/bash
# packages.yml hash: {{ include "ansible/playbooks/packages.yml" | sha256sum }}
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

set -e

# Ensure brew is on PATH (needed on Apple Silicon when shell hasn't sourced brew env)
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Ensure Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Ensure Ansible is installed
if ! command -v ansible &> /dev/null; then
    echo "Ansible not found. Installing via Homebrew..."
    brew install ansible
fi

# Pre-warm sudo so brew cask pkg installers (Docker, Tailscale) don't need a TTY.
# Ansible's -K handles become: yes tasks; this handles sudo calls brew makes internally.
sudo -v
while true; do sudo -n true; sleep 50; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_KEEPALIVE_PID=$!
trap "kill $SUDO_KEEPALIVE_PID 2>/dev/null" EXIT

ansible-playbook -K {{ .chezmoi.sourceDir }}/ansible/playbooks/packages.yml

